{
	// Cloudflare Workers config: serve the static SvelteKit build (adapter-static) as static assets.
	// Without this file, `wrangler deploy` tries to auto-configure SvelteKit and install
	// @sveltejs/adapter-cloudflare, which fails.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "edwardbatt-site",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./build",
		"not_found_handling": "none"
	}
}
